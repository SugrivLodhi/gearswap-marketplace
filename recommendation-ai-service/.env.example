APP_ENV=development
APP_PORT=9010
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=10

REDIS_URL=redis://redis:6379/0
RECOMMENDATION_CACHE_TTL_SECONDS=120
MONGODB_URI=mongodb://mongo:27017/gearswap
MONGODB_DB_NAME=gearswap
RECOMMENDATION_CANDIDATE_POOL_SIZE=500
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=recommendation-ai-service
KAFKA_CLIENT_ID=gearswap-recommendation-ai-service
KAFKA_TOPICS=["product.created","product.updated","product.deleted","cart.updated","order.checkout.initiated","user.registered"]

DEFAULT_RECOMMENDATION_LIMIT=8
MAX_RECOMMENDATION_LIMIT=24
